meta {
  name: Duplicate Slug (expect 409)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sites
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Main Warehouse Duplicate",
    "slug": "main-warehouse",
    "timeZone": "Europe/Amsterdam",
    "description": "Should collide on slug"
  }
}

docs {
  Run Create Site first so the "main-warehouse" slug already exists.
  Expect: 409 with Site.SlugAlreadyExists.
}
